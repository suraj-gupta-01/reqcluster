FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/

# cpu|gpu torch build is required; add e.g. "--extra nlp" via EXTRAS.
ARG EXTRAS="--extra cpu --extra fast --extra postgres"
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PROJECT_ENVIRONMENT=/app/.venv UV_NO_CACHE=1 \
    HF_HOME=/app/var/cache/hf
WORKDIR /app

COPY pyproject.toml uv.lock ./
# hnswlib ships no wheel: compile it (the toolchain stays in this stage only).
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && uv sync --frozen --no-dev --no-install-project $EXTRAS

COPY README.md ./
COPY backend/ ./backend/
RUN uv sync --frozen --no-dev $EXTRAS

# Bake the SBERT model so first start needs no network.
RUN uv run --no-sync python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# Warm numba's on-disk JIT cache (beside the installed umap/pynndescent) so a fresh container's
# first clustering job skips the ~70 s recompile.
RUN uv run --no-sync python -c "import numpy as np; from reqcluster.ml.reduce import reduce; r = np.random.default_rng(0); [reduce(r.standard_normal((n, 384)).astype('float32'), 0) for n in (60, 1200)]"  # both UMAP paths (<1k own kNN, >=1k precomputed)

# Test suites and torch C++ headers are dead weight at runtime.
RUN find /app/.venv/lib -type d \( -name tests -o -name test \) -path "*site-packages*" -prune -exec rm -rf {} + \
    && rm -rf /app/.venv/lib/python3.12/site-packages/torch/include

FROM python:3.12-slim
ENV HF_HOME=/app/var/cache/hf REQCLUSTER_HOST=0.0.0.0 REQCLUSTER_HOME=/app/var \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/backend /app/backend
COPY --from=builder /app/var/cache/hf /app/var/cache/hf
RUN useradd --create-home app && chown -R app /app/var
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"]
CMD ["/app/.venv/bin/reqcluster-api"]
