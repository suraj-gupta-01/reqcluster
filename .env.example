# Copy to .env (read by backend/reqcluster/config.py; real env vars win).

# --- Server ---
# REQCLUSTER_HOME=./var                # data dir: db, cache, runs
# DATABASE_URL=                       # default sqlite:///<HOME>/reqcluster.db; or postgresql://user:pw@host:5432/db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # comma-separated
REQCLUSTER_HOST=127.0.0.1             # use 0.0.0.0 in containers
REQCLUSTER_PORT=8000
REQCLUSTER_API_KEY=                   # empty = no auth
REQCLUSTER_JOB_WORKERS=1              # background job threads (0 = run inline)
REQCLUSTER_SEED=42                    # deterministic UMAP/HDBSCAN
REQCLUSTER_THREADS=                   # default: CPU count

# --- Embeddings ---
# auto = Alibaba-NLP/gte-modernbert-base on an NVIDIA GPU (more accurate), all-MiniLM-L6-v2 on CPU (9x faster there).
# Pin one explicitly for identical results across machines.
REQCLUSTER_EMBEDDING_MODEL=auto
REQCLUSTER_EMBEDDING_REVISION=1       # bump to invalidate embedding cache
REQCLUSTER_EMBEDDING_BACKEND=torch    # torch | mock
REQCLUSTER_EMBEDDING_DEVICE=auto      # auto | cpu | cuda; set cpu for reproducible clusters across machines

# --- Uploads ---
REQCLUSTER_MAX_UPLOAD_MB=25
REQCLUSTER_MAX_ROWS=50000

# --- LLM ---
REQCLUSTER_LLM_PROVIDER=mock          # mock | openai | local
# OpenAI-compatible provider
REQCLUSTER_LLM_BASE_URL=
REQCLUSTER_LLM_API_KEY=
REQCLUSTER_LLM_MODEL=
# Local provider (Ollama); alternates: gemma4:e4b, qwen3.5:2b
REQCLUSTER_LOCAL_LLM_URL=http://localhost:11434
REQCLUSTER_LOCAL_LLM_MODEL=qwen3.5:4b
# Local models are slow (measured qwen3.5:4b on a 4 GB GPU: ~17 s per requirement, 100 s cold load).
# Ollama serves one request at a time, so keep concurrency 1; the model is loaded once and kept resident.
REQCLUSTER_LOCAL_LLM_TIMEOUT_SECONDS=120
REQCLUSTER_LOCAL_LLM_LOAD_TIMEOUT_SECONDS=600
REQCLUSTER_LOCAL_LLM_CONCURRENCY=1
REQCLUSTER_LOCAL_LLM_KEEP_ALIVE=30m
# Resilience
REQCLUSTER_LLM_TIMEOUT_SECONDS=30
REQCLUSTER_LLM_MAX_RETRIES=2          # 0-5
REQCLUSTER_LLM_CONCURRENCY=4
REQCLUSTER_BREAKER_THRESHOLD=5        # consecutive failures before circuit opens
REQCLUSTER_BREAKER_COOLDOWN_SECONDS=60

# --- spaCy (optional extra: nlp) ---
REQCLUSTER_SPACY_MODEL=en_core_web_sm
REQCLUSTER_DISABLE_SPACY=false

# --- Jama export ---
REQCLUSTER_JAMA_PROJECT_ID=0
REQCLUSTER_JAMA_ITEM_TYPE_ID=33
REQCLUSTER_JAMA_REL_TYPE_ID=1
